# Django core
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# Database
DJANGO_DATABASE_ENGINE=mysql
DJANGO_DATABASE_NAME=your_database_name
DJANGO_DATABASE_USER=your_database_user
DJANGO_DATABASE_PASSWORD=your_database_password
DJANGO_DATABASE_HOST=localhost
DJANGO_DATABASE_PORT=3306

# Security
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_SSL_REDIRECT=True

# HSTS
# Keep 0 for the first deployment.
# Increase only after HTTPS works reliably.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# Email
# For first deployment keep console backend.
# Later replace it with SMTP backend.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL="City Map <noreply@example.com>"
DJANGO_FEEDBACK_RECIPIENT_EMAIL=admin@example.com
DJANGO_FEEDBACK_THROTTLE_RATE=5/hour

# SMTP, fill later
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
